                "air-traffic",
                "booked"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) Code for the origin city following IATA standard ([IATA table codes](http://www.iata.org/publications/Pages/code-search.aspx)). - e.g. BOS for Boston",
                    "type": "text/plain"
                  },
                  "key": "originCityCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) period when consumers are traveling.\n* It can be a month only. \n* ISO format must be used - e.g. 2015-05. \n* Period ranges are not supported. \n* Only periods from 2011-01 up to previous month are valid. \n* Future dates are not supported.\n",
                    "type": "text/plain"
                  },
                  "key": "period",
                  "value": ""
                },
                {
                  "description": {
                    "content": "maximum number of destinations in the response. Default value is 10 and maximum value is 50.",
