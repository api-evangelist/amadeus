            "description": {
              "content": "",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "travel",
                "analytics",
                "air-traffic",
                "busiest-period"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) Code for the city following IATA standard. [IATA table codes](http://www.iata.org/publications/Pages/code-search.aspx) - e.g. BOS for Boston",
                    "type": "text/plain"
                  },
                  "key": "cityCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) time period (year) of the statistics.\n\nYear for which the statistic are requested following [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601)\n",
                    "type": "text/plain"
                  },
                  "key": "period",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Use ARRIVING to have statistics on travelers coming to the city or DEPARTING for statistics on travelers leaving the city.\n\nBy default, statistics are given on travelers ARRIVING the city.\n (This can only be one of ARRIVING,DEPARTING)",
                    "type": "text/plain"
                  },
                  "key": "direction",
                  "value": ""
                }
              ],
