              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) city/airport [IATA code](http://www.iata.org/publications/Pages/code-search.aspx) from which the traveler is departing, e.g. PAR for Paris",
                    "type": "text/plain"
                  },
                  "key": "originLocationCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) city/airport [IATA code](http://www.iata.org/publications/Pages/code-search.aspx) to which the traveler is going, e.g. PAR for Paris",
                    "type": "text/plain"
                  },
                  "key": "destinationLocationCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) the date on which the traveler will depart from the origin to go to the destination. Dates are specified in the [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) YYYY-MM-DD format, e.g. 2019-12-25",
                    "type": "text/plain"
                  },
                  "key": "departureDate",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) local time relative to originLocationCode on which the traveler will depart from the origin. Time respects ISO 8601 standard. e.g. 13:22:00",
                    "type": "text/plain"
                  },
                  "key": "departureTime",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) the date on which the traveler will arrive to the destination from the origin. Dates are specified in the [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) YYYY-MM-DD format, e.g. 2019-12-25",
                    "type": "text/plain"
                  },
                  "key": "arrivalDate",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) local time relative to destinationLocationCode on which the traveler will arrive to destination. Time respects ISO 8601 standard. e.g. 13:22:00",
                    "type": "text/plain"
                  },
                  "key": "arrivalTime",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) IATA aircraft code (http://www.flugzeuginfo.net/table_accodes_iata_en.php)",
                    "type": "text/plain"
                  },
                  "key": "aircraftCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) airline / carrier code",
                    "type": "text/plain"
                  },
                  "key": "carrierCode",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) flight number as assigned by the carrier",
                    "type": "text/plain"
                  },
                  "key": "flightNumber",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) flight duration in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) PnYnMnDTnHnMnS format, e.g. PT2H10M",
                    "type": "text/plain"
                  },
                  "key": "duration",
                  "value": ""
                }
              ],
              "variable": []
            },
